# Copy to .env (root) and to bff/.env. Never commit the real file.

# --- Neo4j (local) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=demo-password-change-me
NEO4J_DATABASE=neo4j

# --- BFF ---
BFF_PORT=8787
# Comma-separated origins allowed to hit the BFF (the web app).
BFF_CORS_ORIGIN=http://localhost:5173

# --- Narrator / Ask (live mode) ---
# LLM transport:
#   api         -> cloud Claude Messages API / Agent SDK (needs ANTHROPIC_API_KEY)
#   claude-code -> spawn the local `claude` CLI; auth rides on your Claude Code
#                  login (subscription) so NO API key is needed and no raw key
#                  lives in the BFF. Requires `claude` on PATH and a logged-in session.
LLM_PROVIDER=api
# Cloud Claude Opus 5. Leave blank (with LLM_PROVIDER=api) to force scripted/cached-only mode.
ANTHROPIC_API_KEY=
NARRATOR_MODEL=claude-opus-5
# Per-call live timeout (ms) before falling back to cached narration.
NARRATOR_TIMEOUT_MS=6000
# Local Claude Code CLI provider (LLM_PROVIDER=claude-code).
CLAUDE_BIN=claude
CLAUDE_MAX_TURNS=6

# --- Per-surface: narration (/narrate, one-shot, no tool-loop) ---
# Narration is structurally grounded + citation-validated before the audience
# sees it, so a cheaper/smaller model is safe here (e.g. claude-haiku-4-5-20251001
# to cut tokens). Falls back to NARRATOR_MODEL when unset.
NARRATE_MODEL=claude-opus-5
NARRATE_IDLE_TIMEOUT_MS=20000
NARRATE_HARD_TIMEOUT_MS=30000
# max_tokens passed to the cloud Messages API (narration only).
NARRATE_MAX_TOKENS=400

# --- Per-surface: ask-anything (/ask, multi-turn tool-loop over Neo4j) ---
# Drives valid Cypher + multi-hop reasoning. Do NOT downgrade below Sonnet-tier
# without correctness testing. Falls back to NARRATOR_MODEL when unset.
ASK_MODEL=claude-opus-5
# Idle watchdog per MCP iteration (ms) — must outlast the worst Neo4j round-trip.
ASK_IDLE_TIMEOUT_MS=45000
# Absolute hard-abort cap for a full /ask run (ms).
ASK_HARD_TIMEOUT_MS=300000
# --max-turns for the `claude` CLI during /ask (min 3: schema+query+answer).
ASK_MAX_TURNS=12

# Air-gapped (Wave 2): point the SDK at an OpenAI-compatible local gateway instead.
# Leave unset for the cloud demo. Verify Agent SDK base-url support before using.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=

# --- Neo4j MCP server (ask-anything mode; read-only) ---
# The BFF spawns `uvx mcp-neo4j-cypher@<version>` for the agent's tool-loop.
# Read-only is enforced via the server's --read-only CLI flag (verified live).
NEO4J_MCP_READONLY=true
# Version uvx resolves. Pinned to 0.6.0 for reproducibility (was `latest`).
# NOTE: the once-assumed 1.5.3 does NOT exist on PyPI — do not pin to it.
# Requires `uvx` (from uv) on PATH.
NEO4J_MCP_VERSION=0.6.0

# --- RDF/SHACL reasoner backend ---
# oxigraph -> in-process WASM (default, no sidecar). fuseki -> external Jena.
# An env value here takes precedence over the persisted admin config.
REASONER_BACKEND=oxigraph
# Fuseki-only (REASONER_BACKEND=fuseki). Leave commented for the default backend.
# FUSEKI_URL=http://localhost:3030/rtg
# Optional HTTP Basic auth for Fuseki update + Graph-Store. Absent = open/dev.
# FUSEKI_USER=
# FUSEKI_PASSWORD=

# --- Persistence paths (both have sane built-in defaults; usually leave unset) ---
# Live-editable prompts/marker/thresholds, hot-applied with no restart.
# Default: bff/admin-config.json. Tests override this per-worker via test-setup.ts —
# do NOT hand-set it when running `npm test -w bff`.
# ADMIN_CONFIG_PATH=
# Conversation history for Beat 4 (messages + grounding state per thread).
# Default: bff/threads.json.
# THREADS_STORE_PATH=
