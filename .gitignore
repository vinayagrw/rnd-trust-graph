# Live-editable admin config (Phase 3a) — created on first PUT; deleting it
# falls back to byte-identical defaults. Not committed.
bff/admin-config.json

# Conversation thread store (Phase 5) — Beat-4 chat history, created on first
# save; deleting it just empties history. History-only (no Neo4j). Not committed.
bff/threads.json

# FinOps token ledger (FinOps observability) — LLM usage/cost records, created
# on the first LLM call; deleting it just empties spend history. Not committed.
bff/finops-ledger.json

# HITL change-set audit log (governed mutate+revert) — reviewer-approved,
# reversible graph changes, created on first apply; deleting it empties the audit
# log. Mutations live durably in Neo4j + the RDF store regardless. Not committed.
bff/hitl-changesets.json

# Custom playbooks (AI-assisted authoring) — user-created safety-dossier
# definitions, created on first save; deleting it just removes custom playbooks
# (curated ones ship in code). Orchestration config only, no Neo4j. Not committed.
bff/playbooks-custom.json

# Playbook routines + run history (scheduled runs) — schedule config + a bounded
# run log, created on first save; deleting it just clears schedules/history.
# Orchestration config only (decides WHEN a playbook runs), no Neo4j. Not committed.
bff/routines.json

