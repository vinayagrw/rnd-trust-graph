    rtg:sourceSystem "PubMed" ;
    rtg:timestamp "2026-06-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:CON-RA a rtg:Concept ;
    rdfs:label "Rheumatoid arthritis" ;
    rtg:code "MONDO_0008383" ;
    prov:wasDerivedFrom "MONDO" ;
    rtg:sourceSystem "MONDO" ;
    rtg:ontologyVersion "2026-06" ;
    rtg:timestamp "2026-06-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC-BY-4.0" .

# Open Targets-style genetic association (new rtg:GeneticAssociation kind).
rtg:GA-OT-JAK1-RA a rtg:GeneticAssociation ;
    rdfs:label "Open Targets: JAK1-rheumatoid-arthritis association" ;
    rtg:code "ENSG00000162434" ;
    rtg:otScore "0.52"^^xsd:decimal ;
    rtg:efo "EFO_0000685" ;
    prov:wasDerivedFrom "Open Targets" ;
    rtg:sourceSystem "Open Targets" ;
    rtg:ontologyVersion "2024-06" ;
    rtg:timestamp "2026-06-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC0" .

# FDA boxed-warning excerpt (new rtg:RegulatoryDoc kind).
rtg:REG-FDA-JAK-INFECTION a rtg:RegulatoryDoc ;
    rdfs:label "FDA boxed warning - JAK inhibitor serious infections (NDA 203214)" ;
    rtg:code "203214" ;
    rtg:section "Boxed Warning" ;
    prov:wasDerivedFrom "DailyMed" ;
    rtg:sourceSystem "DailyMed" ;
    rtg:ontologyVersion "2026-01" ;
    rtg:timestamp "2026-06-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

# Immunology explanation path (mirrors the myocarditis hero shape).
rtg:AE-SERIOUS-INFECTION rtg:SUSPECTED_IN rtg:DRUG-JAK .
rtg:DRUG-JAK             rtg:TARGETS      rtg:TGT-JAK1 .
rtg:TGT-JAK1             rtg:IN_PATHWAY   rtg:PW-JAKSTAT .
rtg:AE-SERIOUS-INFECTION rtg:HAS_STAT     rtg:STAT-JAK-INFECTION .
rtg:STAT-JAK-INFECTION   rtg:SUPPORTED_BY rtg:EV-PMID-JAK .

# New edge kinds wiring the new node kinds in.
rtg:GA-OT-JAK1-RA        rtg:GENETIC_EVIDENCE rtg:TGT-JAK1 .
rtg:GA-OT-JAK1-RA        rtg:GENETIC_EVIDENCE rtg:CON-RA .
rtg:REG-FDA-JAK-INFECTION rtg:HAS_LABEL       rtg:DRUG-JAK .
rtg:REG-FDA-JAK-INFECTION rtg:HAS_LABEL       rtg:AE-SERIOUS-INFECTION .

rtg:AE-SERIOUS-INFECTION rtg:IN_ONTOLOGY rtg:ONTO-MEDDRA-27 .
rtg:PW-JAKSTAT           rtg:IN_ONTOLOGY rtg:ONTO-REACTOME-88 .
