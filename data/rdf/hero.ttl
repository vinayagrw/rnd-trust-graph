# =============================================================================
# R&D Trust Graph — canonical W3C-RDF model of the hero subgraph (Turtle).
#
# This file is the SOURCE-OF-TRUTH artifact for the W3C/RDF stack
# (OWL / RDF / SHACL / SPARQL). It is hand-authored and version-controlled.
#
# Production architecture: in production this model lives in a NATIVE TRIPLESTORE
# (GraphDB / Amazon Neptune / Apache Jena Fuseki) addressable by SPARQL, with
# Neo4j projected from it via the neosemantics (n10s) plugin as a low-latency
# serving cache for the interactive force-graph. In this demo n10s is NOT
# installed, so the BFF serializes the live Neo4j hero subgraph to RDF on the
# fly (GET /api/rdf, see bff/src/graph/rdf.ts) — same vocabulary as below.
#
# The SHACL shapes in data/shacl/shapes.ttl validate this model.
#
# License hygiene: every asserted fact carries a commercial-clean license only
# (CC0 / CC-BY-4.0 / public-domain / Apache-2.0). No copyleft, no proprietary.
# =============================================================================

@prefix rtg:     <https://vinayagrw.github.io/rnd-trust-graph#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# -----------------------------------------------------------------------------
# Nodes
# -----------------------------------------------------------------------------

rtg:AE-MYOCARDITIS a rtg:AdverseEvent ;
    rdfs:label "Immune-related myocarditis (OAE_0001489)" ;
    rtg:code "OAE_0001489" ;
    prov:wasDerivedFrom "OAE" ;
    rtg:sourceSystem "OAE" ;
    rtg:ontologyVersion "2025-09" ;
    rtg:timestamp "2026-06-02T10:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC-BY-4.0" .

rtg:DRUG-CPI a rtg:Drug ;
    rdfs:label "Checkpoint inhibitor (anti-PD-1)" ;
    rtg:code "RXN-2563889" ;
    rtg:class "PD-1 inhibitor" ;
    prov:wasDerivedFrom "RxNorm" ;
    rtg:sourceSystem "RxNorm" ;
    rtg:ontologyVersion "2026-06" ;
    rtg:timestamp "2026-06-02T10:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:TGT-PDCD1 a rtg:BiologicalTarget ;
    rdfs:label "PD-1 / PDCD1" ;
    rtg:code "P15116" ;
    prov:wasDerivedFrom "Hetionet" ;
    rtg:sourceSystem "Hetionet" ;
    rtg:ontologyVersion "2026-04" ;
    rtg:timestamp "2026-06-02T10:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC0" .

rtg:PW-CHECKPOINT a rtg:Pathway ;
    rdfs:label "T-cell immune checkpoint signaling" ;
    rtg:code "WP4585" ;
    prov:wasDerivedFrom "Hetionet" ;
    rtg:sourceSystem "Hetionet" ;
    rtg:ontologyVersion "2026-05" ;
    rtg:timestamp "2026-06-02T10:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC0" .

rtg:STAT-MYO-CPI a rtg:SignalStat ;
    rdfs:label "Disproportionality (PRR 4.2)" ;
    rtg:prr "4.2"^^xsd:decimal ;
    rtg:ror "4.6"^^xsd:decimal ;
    rtg:chi2 "58.3"^^xsd:decimal ;
    rtg:ci "2.9-6.1" ;
    rtg:cases "37"^^xsd:decimal ;
    prov:wasDerivedFrom "openFDA FAERS" ;
    rtg:sourceSystem "openFDA FAERS" ;
    rtg:timestamp "2026-06-15T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:EV-FAERS a rtg:Evidence ;
    rdfs:label "openFDA FAERS aggregate 2024Q1-2026Q2" ;
    rtg:records "37"^^xsd:decimal ;
    prov:wasDerivedFrom "openFDA FAERS" ;
    rtg:sourceSystem "openFDA FAERS" ;
    rtg:timestamp "2026-06-15T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:EV-PMID a rtg:Evidence ;
    rdfs:label "Lit: checkpoint-inhibitor myocarditis (synthetic PMID 99000001)" ;
    rtg:code "99000001" ;
    prov:wasDerivedFrom "Synthetic citation" ;
    rtg:sourceSystem "Synthetic citation" ;
    rtg:timestamp "2026-06-10T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

# -----------------------------------------------------------------------------
# Relationships — the deterministic explanation path
#   (:Patient)-[:REPORTS]->(:AdverseEvent)
#   (:AdverseEvent)-[:SUSPECTED_IN]->(:Drug)-[:TARGETS]->(:BiologicalTarget)
#       -[:IN_PATHWAY]->(:Pathway)
#   (:AdverseEvent)-[:HAS_STAT]->(:SignalStat)-[:SUPPORTED_BY]->(:Evidence)
# -----------------------------------------------------------------------------

rtg:AE-MYOCARDITIS rtg:SUSPECTED_IN rtg:DRUG-CPI .
rtg:DRUG-CPI       rtg:TARGETS      rtg:TGT-PDCD1 .
rtg:TGT-PDCD1      rtg:IN_PATHWAY   rtg:PW-CHECKPOINT .
rtg:AE-MYOCARDITIS rtg:HAS_STAT     rtg:STAT-MYO-CPI .
rtg:STAT-MYO-CPI   rtg:SUPPORTED_BY rtg:EV-FAERS .
rtg:STAT-MYO-CPI   rtg:SUPPORTED_BY rtg:EV-PMID .

# =============================================================================
# Workstream-1 extension — second mechanistically-complete signal
#   anti-VEGFR2 → VEGFR2/KDR → angiogenesis pathway → drug-induced hypertension
# plus the versioned OntologySlice nodes that make the provenance "ontology
# version" real (IN_ONTOLOGY edges anchor codes to a dated release).
# =============================================================================

rtg:AE-HYPERTENSION a rtg:AdverseEvent ;
    rdfs:label "Drug-induced hypertension (MedDRA 10020772)" ;
    rtg:code "10020772" ;
    prov:wasDerivedFrom "MedDRA" ;
    rtg:sourceSystem "MedDRA" ;
    rtg:ontologyVersion "2025-03" ;
    rtg:timestamp "2026-06-12T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:DRUG-VEGFR a rtg:Drug ;
    rdfs:label "Anti-VEGFR2 inhibitor (ramucirumab)" ;
    rtg:code "1535996" ;
    rtg:class "VEGFR2 inhibitor" ;
    prov:wasDerivedFrom "RxNorm" ;
    rtg:sourceSystem "RxNorm" ;
    rtg:ontologyVersion "2026-06" ;
    rtg:timestamp "2026-06-12T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:TGT-KDR a rtg:BiologicalTarget ;
