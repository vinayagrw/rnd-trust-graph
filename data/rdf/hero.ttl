    rtg:sourceSystem "PubMed" ;
    rtg:timestamp "2026-06-12T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:ONTO-MESH-2026-06 a rtg:OntologySlice ;
    rdfs:label "MeSH 2026 release" ;
    rtg:url "https://meshb.nlm.nih.gov" ;
    prov:wasDerivedFrom "NLM MeSH" ;
    rtg:sourceSystem "NLM MeSH" ;
    rtg:ontologyVersion "2026-06" ;
    rtg:timestamp "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:ONTO-MONDO-2026-06 a rtg:OntologySlice ;
    rdfs:label "MONDO 2026-06 release" ;
    rtg:url "https://mondo.monarchinitiative.org" ;
    prov:wasDerivedFrom "MONDO" ;
    rtg:sourceSystem "MONDO" ;
    rtg:ontologyVersion "2026-06" ;
    rtg:timestamp "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:ONTO-OAE-2025-09 a rtg:OntologySlice ;
    rdfs:label "OAE 2025-09 release" ;
    rtg:url "https://www.oae-ontology.org" ;
    prov:wasDerivedFrom "OAE" ;
    rtg:sourceSystem "OAE" ;
    rtg:ontologyVersion "2025-09" ;
    rtg:timestamp "2025-09-01T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:ONTO-REACTOME-88 a rtg:OntologySlice ;
    rdfs:label "Reactome v88 release" ;
    rtg:url "https://reactome.org" ;
    prov:wasDerivedFrom "Reactome" ;
    rtg:sourceSystem "Reactome" ;
    rtg:ontologyVersion "2026-03" ;
    rtg:timestamp "2026-03-01T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:ONTO-MEDDRA-27 a rtg:OntologySlice ;
    rdfs:label "MedDRA v27.0 release" ;
    rtg:url "https://www.meddra.org" ;
    prov:wasDerivedFrom "MedDRA" ;
    rtg:sourceSystem "MedDRA" ;
    rtg:ontologyVersion "2025-03" ;
    rtg:timestamp "2025-03-01T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

# VEGF→hypertension explanation path (mirrors the myocarditis hero shape).
rtg:AE-HYPERTENSION rtg:SUSPECTED_IN rtg:DRUG-VEGFR .
rtg:DRUG-VEGFR      rtg:TARGETS      rtg:TGT-KDR .
rtg:TGT-KDR         rtg:IN_PATHWAY   rtg:PW-ANGIO .
rtg:AE-HYPERTENSION rtg:HAS_STAT     rtg:STAT-VEGF-HTN .
rtg:STAT-VEGF-HTN   rtg:SUPPORTED_BY rtg:EV-PMID-VEGF .

# Ontology anchoring — every coded entity belongs to a dated ontology slice.
rtg:AE-MYOCARDITIS rtg:IN_ONTOLOGY rtg:ONTO-OAE-2025-09 .
rtg:AE-HYPERTENSION rtg:IN_ONTOLOGY rtg:ONTO-MEDDRA-27 .
rtg:PW-CHECKPOINT  rtg:IN_ONTOLOGY rtg:ONTO-REACTOME-88 .
rtg:PW-ANGIO       rtg:IN_ONTOLOGY rtg:ONTO-REACTOME-88 .

# =============================================================================
# Phase-1 extension — new therapeutic area (Immunology / rheumatoid arthritis)
#   JAK inhibitor (tofacitinib) → JAK1 → JAK-STAT signaling → serious infection
# plus two NEW node kinds expressed in the same generic vocabulary:
#   rtg:GeneticAssociation  (Open Targets-style target↔disease evidence)
#   rtg:RegulatoryDoc       (FDA label / EMA assessment excerpt)
# =============================================================================

rtg:AE-SERIOUS-INFECTION a rtg:AdverseEvent ;
    rdfs:label "Serious infection - pneumonia (MedDRA 10035664)" ;
    rtg:code "10035664" ;
    prov:wasDerivedFrom "MedDRA" ;
    rtg:sourceSystem "MedDRA" ;
    rtg:ontologyVersion "2025-03" ;
    rtg:timestamp "2026-06-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:DRUG-JAK a rtg:Drug ;
    rdfs:label "JAK inhibitor (tofacitinib)" ;
    rtg:code "CHEMBL221959" ;
    rtg:class "JAK inhibitor" ;
    prov:wasDerivedFrom "ChEMBL" ;
    rtg:sourceSystem "ChEMBL" ;
    rtg:ontologyVersion "2024-03" ;
    rtg:timestamp "2026-06-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC-BY-4.0" .

rtg:TGT-JAK1 a rtg:BiologicalTarget ;
