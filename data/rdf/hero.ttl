    rtg:code "P23458" ;
    rtg:symbol "JAK1" ;
    prov:wasDerivedFrom "UniProt" ;
    rtg:sourceSystem "UniProt" ;
    rtg:ontologyVersion "2026-04" ;
    rtg:timestamp "2026-06-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC-BY-4.0" .

rtg:PW-JAKSTAT a rtg:Pathway ;
    rdfs:label "JAK-STAT signaling (cytokine)" ;
    rtg:code "R-HSA-6785807" ;
    prov:wasDerivedFrom "Reactome" ;
    rtg:sourceSystem "Reactome" ;
    rtg:ontologyVersion "2026-03" ;
    rtg:timestamp "2026-06-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC-BY-4.0" .

rtg:STAT-JAK-INFECTION a rtg:SignalStat ;
    rdfs:label "Disproportionality (PRR 3.9)" ;
    rtg:prr "3.9"^^xsd:decimal ;
    rtg:ror "4.1"^^xsd:decimal ;
    rtg:chi2 "47.6"^^xsd:decimal ;
    rtg:ci "2.7-5.6" ;
    rtg:cases "34"^^xsd:decimal ;
    prov:wasDerivedFrom "openFDA FAERS" ;
    rtg:sourceSystem "openFDA FAERS" ;
    rtg:timestamp "2026-06-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:EV-PMID-JAK a rtg:Evidence ;
    rdfs:label "Lit: serious infections with tofacitinib (PMID 28953575)" ;
