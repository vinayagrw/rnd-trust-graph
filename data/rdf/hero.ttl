    prov:wasDerivedFrom "UniProt" ;
    rtg:sourceSystem "UniProt" ;
    rtg:ontologyVersion "2026-04" ;
    rtg:timestamp "2026-06-12T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC-BY-4.0" .

rtg:PW-ANGIO a rtg:Pathway ;
    rdfs:label "VEGFA-VEGFR2 signaling (angiogenesis)" ;
    rtg:code "R-HSA-4420097" ;
    prov:wasDerivedFrom "Reactome" ;
    rtg:sourceSystem "Reactome" ;
    rtg:ontologyVersion "2026-03" ;
    rtg:timestamp "2026-06-12T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "CC-BY-4.0" .

rtg:STAT-VEGF-HTN a rtg:SignalStat ;
    rdfs:label "Disproportionality (PRR 3.6)" ;
    rtg:prr "3.6"^^xsd:decimal ;
    rtg:ror "3.8"^^xsd:decimal ;
    rtg:chi2 "41.2"^^xsd:decimal ;
    rtg:ci "2.4-5.1" ;
    rtg:cases "29"^^xsd:decimal ;
    prov:wasDerivedFrom "openFDA FAERS" ;
    rtg:sourceSystem "openFDA FAERS" ;
    rtg:timestamp "2026-06-15T00:00:00Z"^^xsd:dateTime ;
    dcterms:license "public-domain" .

rtg:EV-PMID-VEGF a rtg:Evidence ;
    rdfs:label "Lit: VEGF-inhibitor hypertension (PMID 20694011)" ;
